# Only needed for the OPTIONAL Crewbit server. The web app on GitHub Pages and
# the mobile app don't use this file - you enter keys in the app's Settings.

# Keys the server may use when an app sends a request without its own key.
# Name: <PROVIDER>_API_KEY, matching the provider list in the app.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# FIREWORKS_API_KEY=

# Require apps to send this token. Set it whenever the server is reachable
# from the internet, otherwise anyone can spend your keys.
CREWBIT_ACCESS_TOKEN=

PORT=8787
