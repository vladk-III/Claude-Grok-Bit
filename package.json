{
  "name": "crewbit",
  "private": true,
  "version": "0.1.0",
  "description": "A Claude-powered chat bot with multi-agent crews - web and mobile.",
  "workspaces": [
    "shared",
    "server",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace server",
    "mobile": "npm run start --workspace mobile"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
